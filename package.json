{
  "name": "xmessenger-root",
  "version": "2.2.0",
  "private": true,
  "description": "Secure One-Way (Hub-and-Spoke) Messenger with Ephemeral Messages and Linux Auto-Installer",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test"
  },
  "keywords": [
    "messenger",
    "secure",
    "hub-and-spoke",
    "ephemeral-messages",
    "rtl-persian"
  ],
  "author": "",
  "license": "MIT"
}
