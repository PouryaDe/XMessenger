{
  "name": "xmessenger-server",
  "version": "2.2.2",
  "description": "Backend server for XMessenger",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npx esbuild src/index.ts --bundle --platform=node --target=node20 --external:better-sqlite3 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
